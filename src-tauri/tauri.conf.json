{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeanyLab",
  "version": "0.1.0",
  "identifier": "com.beanylab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BeanyLab",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "fileAssociations": [
      { "ext": ["m"], "name": "BeanyLab Code File", "description": "MATLAB-language code file", "role": "Editor" }
    ]
  }
}
