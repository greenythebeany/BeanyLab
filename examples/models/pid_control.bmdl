{
  "version": 1,
  "name": "pid_control",
  "solver": { "solver": "ode45", "stop_time": "10", "rel_tol": "1e-6", "abs_tol": "1e-9" },
  "blocks": [
    { "id": "ref", "type": "Step", "name": "Setpoint", "x": 40, "y": 100, "params": { "time": "0", "initial": "0", "final": "1" } },
    { "id": "err", "type": "Sum", "name": "Error", "x": 160, "y": 100, "w": 50, "params": { "signs": "+-" } },
    { "id": "pid", "type": "PID", "name": "PID", "x": 260, "y": 100, "params": { "P": "2", "I": "1", "D": "0" } },
    { "id": "plant", "type": "TransferFcn", "name": "Motor", "x": 400, "y": 100, "w": 90, "params": { "num": "1", "den": "[1 1]" } },
    { "id": "scope", "type": "Scope", "name": "Speed", "x": 580, "y": 40, "params": { "inputs": "2" } },
    { "id": "log", "type": "ToWorkspace", "name": "Log speed", "x": 580, "y": 160, "params": { "variable": "speed" } }
  ],
  "lines": [
    { "src": { "block": "ref", "port": 1 }, "dst": { "block": "err", "port": 1 } },
    { "src": { "block": "err", "port": 1 }, "dst": { "block": "pid", "port": 1 } },
    { "src": { "block": "pid", "port": 1 }, "dst": { "block": "plant", "port": 1 } },
    { "src": { "block": "plant", "port": 1 }, "dst": { "block": "err", "port": 2 } },
    { "src": { "block": "ref", "port": 1 }, "dst": { "block": "scope", "port": 1 } },
    { "src": { "block": "plant", "port": 1 }, "dst": { "block": "scope", "port": 2 } },
    { "src": { "block": "plant", "port": 1 }, "dst": { "block": "log", "port": 1 } }
  ]
}
