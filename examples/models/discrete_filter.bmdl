{
  "version": 1,
  "name": "discrete_filter",
  "solver": { "solver": "auto", "stop_time": "2" },
  "blocks": [
    { "id": "step", "type": "Step", "name": "Step", "x": 40, "y": 100, "params": { "time": "0", "initial": "0", "final": "1" } },
    { "id": "lpf", "type": "DiscreteTransferFcn", "name": "Low-pass", "x": 180, "y": 100, "w": 100, "params": { "num": "0.2", "den": "[1 -0.8]", "ts": "0.1" } },
    { "id": "scope", "type": "Scope", "name": "Filter output", "x": 360, "y": 40 },
    { "id": "log", "type": "ToWorkspace", "name": "Log yf", "x": 360, "y": 160, "params": { "variable": "yf" } }
  ],
  "lines": [
    { "src": { "block": "step", "port": 1 }, "dst": { "block": "lpf", "port": 1 } },
    { "src": { "block": "lpf", "port": 1 }, "dst": { "block": "scope", "port": 1 } },
    { "src": { "block": "lpf", "port": 1 }, "dst": { "block": "log", "port": 1 } }
  ]
}
